---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "WeGrow HR & Payroll Portal — Campus & B-School",
  description = "Unified role-based HR, attendance, biometric tracking, leave approvals, and payroll portal for WeGrow Skill Campus and B-School."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate, max-age=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A1B45" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Route Protection & Session Verification Script -->
    <script is:inline>
      (function() {
        function getAuthToken() {
          try {
            var token = localStorage.getItem("access_token") || localStorage.getItem("wg_token");
            if (!token) {
              var match = document.cookie.match(/(?:^|; )wg_token=([^;]*)/);
              if (match && match[1]) {
                token = decodeURIComponent(match[1]);
              }
            }
            return token;
          } catch (e) {
            return null;
          }
        }

        function verifyRouteAccess() {
          try {
            var path = window.location.pathname.replace(/\/$/, '') || '/';
            var isLoginPage = path === '/login';
            var isRootPage = path === '/';
            var token = getAuthToken();

            // Track last visited protected route
            if (token && !isLoginPage && !isRootPage) {
              try {
                localStorage.setItem("last_visited_path", window.location.pathname);
              } catch (e) {}
            }

            if (!token && !isLoginPage && !isRootPage) {
              // Unauthenticated user attempting to access protected dashboard pages -> redirect immediately to login
              window.location.replace('/login');
            } else if (token && (isLoginPage || isRootPage)) {
              // Authenticated user on login or root page -> redirect to last visited screen (or /dashboard)
              var targetPath = '/dashboard';
              try {
                var saved = localStorage.getItem("last_visited_path");
                if (saved && saved !== '/login' && saved !== '/') {
                  targetPath = saved;
                }
              } catch (e) {}
              window.location.replace(targetPath);
            }
          } catch (e) {
            // Fallback
          }
        }

        // Run immediately before page rendering
        verifyRouteAccess();

        // Handle Browser Back / Forward Cache (bfcache) navigation after logout
        window.addEventListener('pageshow', function(event) {
          verifyRouteAccess();
        });

        // Handle popstate events
        window.addEventListener('popstate', function() {
          verifyRouteAccess();
        });

        // Handle multi-tab logout events
        window.addEventListener('storage', function(e) {
          if (e.key === 'access_token' || e.key === 'wg_token' || e.key === null) {
            verifyRouteAccess();
          }
        });
      })();
    </script>
  </head>
  <body class="min-h-full flex flex-col bg-[#F4F5F9] text-[#12173A]">
    <slot />
  </body>
</html>
