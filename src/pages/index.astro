---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="WeGrow HR & Payroll Portal">
  <div class="flex min-h-screen items-center justify-center bg-[#F4F5F9]">
    <div class="flex flex-col items-center gap-3">
      <div class="h-10 w-10 animate-spin rounded-full border-4 border-[#EA6118] border-t-transparent"></div>
      <p class="text-sm font-semibold text-[#5B6180]">Directing to WeGrow HR Portal...</p>
    </div>
  </div>

  <script is:inline>
    (function() {
      try {
        var token = localStorage.getItem("access_token") || localStorage.getItem("wg_token");
        if (token) {
          window.location.replace("/dashboard");
        } else {
          window.location.replace("/login");
        }
      } catch (e) {
        window.location.replace("/login");
      }
    })();
  </script>
</BaseLayout>
